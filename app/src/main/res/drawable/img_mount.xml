<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="640dp" android:height="400dp" />
            <gradient
                android:angle="45"
                android:endColor="#2B7DE9"
                android:startColor="#5ED4B5" />
        </shape>
    </item>
    <item
        android:bottom="110dp"
        android:left="200dp"
        android:right="200dp"
        android:top="110dp">
        <shape android:shape="oval">
            <solid android:color="#55FFFFFF" />
        </shape>
    </item>
</layer-list>
